[Unit]
Description=SAGE local assistant TUI
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/sage
ExecStart=%h/sage/.venv/bin/python -m assistant.main
Restart=on-failure
RestartSec=5
Environment=SAGE_MODEL=phi4-mini

[Install]
WantedBy=default.target
